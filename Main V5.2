cpp#include <Keyboard.h>

// ==========================================
// 1. PIN-KONFIGURATION
// ==========================================
const int tasterWeiss = 2;
const int tasterSchwarz = 3;

// Hubmagneten auf A4 und A5
const int magnetWeiss = A4; 
const int magnetSchwarz = A5; 

// Die beiden Steuerschalter
const int tasterZugWechsel = 8;   // Drücken wechselt den aktuellen Spieler (W/S)
const int tasterUhrSeite = 13;    // Schaltet um, ob Weiß links oder rechts sitzt

// Die 4 LEDs einzeln angesteuert
const int ledGelbLinks = 9;
const int ledRotLinks = 10;
const int ledGelbRechts = 11;
const int ledRotRechts = 12;

// Figurenerkennung (unverändert)
const int pinQ_Weiss = A0; 
const int pinR_Weiss = A1; 
const int pinB_Weiss = A2; 
const int pinN_Weiss = A3; 
const int pinQ_Schwarz = 4; 
const int pinR_Schwarz = 5; 
const int pinB_Schwarz = 6; 
const int pinN_Schwarz = 7; 

// ==========================================
// 2. TIMING-EINSTELLUNGEN
// ==========================================
const unsigned long stoesselDauer = 80;    
const unsigned long entprellZeitUhr = 150;  
const unsigned long entprellZeitFigur = 300;
const unsigned long entprellZeitSchalter = 50; // Bei Flankenerkennung reicht eine kurze Entprellzeit

// ==========================================
// 3. SYSTEMVARIABLEN
// ==========================================
unsigned long magnetAnZeitWeiss = 0;
unsigned long magnetAnZeitSchwarz = 0;
unsigned long letzteUhrWeiss = 0;
unsigned long letzteUhrSchwarz = 0;
unsigned long letzteFigurZeit = 0; 
unsigned long letzteZugWechselZeit = 0;
unsigned long letzteUhrSeiteZeit = 0;

bool magnetAktivWeiss = false;
bool magnetAktivSchwarz = false;

// ZUSTANDSVARIABLEN
char werIstAmZug = 'W';          // 'W' = Weiß, 'S' = Schwarz
bool weissIstLinksSitzen = true; // true = Weiß sitzt links, false = Weiß sitzt rechts

// Variablen für die Flankenerkennung (Zustand im vorherigen Loop-Durchlauf)
int letzterTasterZustandZugWechsel = HIGH;
int letzterTasterZustandUhrSeite = HIGH;

// ==========================================
// 4. SETUP
// ==========================================
void setup() {
  pinMode(tasterWeiss, INPUT_PULLUP);
  pinMode(tasterSchwarz, INPUT_PULLUP);
  pinMode(tasterZugWechsel, INPUT_PULLUP);
  pinMode(tasterUhrSeite, INPUT_PULLUP);
  
  pinMode(magnetWeiss, OUTPUT);
  pinMode(magnetSchwarz, OUTPUT);
  digitalWrite(magnetWeiss, LOW);
  digitalWrite(magnetSchwarz, LOW);

  pinMode(ledGelbLinks, OUTPUT);
  pinMode(ledRotLinks, OUTPUT);
  pinMode(ledGelbRechts, OUTPUT);
  pinMode(ledRotRechts, OUTPUT);

  pinMode(pinQ_Weiss, INPUT_PULLUP);
  pinMode(pinR_Weiss, INPUT_PULLUP);
  pinMode(pinB_Weiss, INPUT_PULLUP);
  pinMode(pinN_Weiss, INPUT_PULLUP);
  pinMode(pinQ_Schwarz, INPUT_PULLUP);
  pinMode(pinR_Schwarz, INPUT_PULLUP);
  pinMode(pinB_Schwarz, INPUT_PULLUP);
  pinMode(pinN_Schwarz, INPUT_PULLUP);

  // LEDs initial passend einschalten
  aktualisiereAnzeige();

  Keyboard.begin();
}

// ==========================================
// 5. MAIN LOOP
// ==========================================
void loop() {
  unsigned long aktuelleZeit = millis();

  // ------------------------------------------
  // SCHALTER 1: MANUELLER SPIELER-WECHSEL (PIN 8)
  // ------------------------------------------
  int aktuellerTasterZugWechsel = digitalRead(tasterZugWechsel);
  
  // Triggert nur, wenn JETZT gedrückt (LOW) und VORHER offen (HIGH)
  if (aktuellerTasterZugWechsel == LOW && letzterTasterZustandZugWechsel == HIGH && (aktuelleZeit - letzteZugWechselZeit >= entprellZeitSchalter)) {
    werIstAmZug = (werIstAmZug == 'W') ? 'S' : 'W';
    aktualisiereAnzeige();
    letzteZugWechselZeit = aktuelleZeit;
  }
  letzterTasterZustandZugWechsel = aktuellerTasterZugWechsel;


  // ------------------------------------------
  // SCHALTER 2: FARB-SEITEN TAUSCHEN (PIN 13)
  // ------------------------------------------
  int aktuellerTasterUhrSeite = digitalRead(tasterUhrSeite);
  
  // Triggert nur, wenn JETZT gedrückt (LOW) und VORHER offen (HIGH)
  if (aktuellerTasterUhrSeite == LOW && letzterTasterZustandUhrSeite == HIGH && (aktuelleZeit - letzteUhrSeiteZeit >= entprellZeitSchalter)) {
    weissIstLinksSitzen = !weissIstLinksSitzen; 
    aktualisiereAnzeige();
    letzteUhrSeiteZeit = aktuelleZeit;
  }
  letzterTasterZustandUhrSeite = aktuellerTasterUhrSeite;


  // ------------------------------------------
  // MECHANISCHES TIMING: STÖSSEL WIEDER EINFAHREN
  // ------------------------------------------
  if (magnetAktivWeiss && (aktuelleZeit - magnetAnZeitWeiss >= stoesselDauer)) {
    digitalWrite(magnetWeiss, LOW);
    magnetAktivWeiss = false;
  }
  if (magnetAktivSchwarz && (aktuelleZeit - magnetAnZeitSchwarz >= stoesselDauer)) {
    digitalWrite(magnetSchwarz, LOW);
    magnetAktivSchwarz = false;
  }

  // ==========================================
  // ZÜGE FÜR WEISS (Nur aktiv, wenn werIstAmZug == 'W')
  // ==========================================
  if (werIstAmZug == 'W') {
    if (digitalRead(tasterWeiss) == LOW && (aktuelleZeit - letzteUhrWeiss >= entprellZeitUhr)) {
      digitalWrite(magnetWeiss, HIGH); magnetAnZeitWeiss = aktuelleZeit; magnetAktivWeiss = true;
      letzteUhrWeiss = aktuelleZeit;
      Keyboard.print("W"); werIstAmZug = 'S'; aktualisiereAnzeige();
    }
    else if (aktuelleZeit - letzteFigurZeit >= entprellZeitFigur) {
      if (digitalRead(pinQ_Weiss) == LOW) {
        digitalWrite(magnetWeiss, HIGH); magnetAnZeitWeiss = aktuelleZeit; magnetAktivWeiss = true;
        Keyboard.print("Q"); letzteFigurZeit = aktuelleZeit; werIstAmZug = 'S'; aktualisiereAnzeige();
      }
      else if (digitalRead(pinR_Weiss) == LOW) {
        digitalWrite(magnetWeiss, HIGH); magnetAnZeitWeiss = aktuelleZeit; magnetAktivWeiss = true;
        Keyboard.print("R"); letzteFigurZeit = aktuelleZeit; werIstAmZug = 'S'; aktualisiereAnzeige();
      }
      else if (digitalRead(pinB_Weiss) == LOW) {
        digitalWrite(magnetWeiss, HIGH); magnetAnZeitWeiss = aktuelleZeit; magnetAktivWeiss = true;
        Keyboard.print("B"); letzteFigurZeit = aktuelleZeit; werIstAmZug = 'S'; aktualisiereAnzeige();
      }
      else if (digitalRead(pinN_Weiss) == LOW) {
        digitalWrite(magnetWeiss, HIGH); magnetAnZeitWeiss = aktuelleZeit; magnetAktivWeiss = true;
        Keyboard.print("N"); letzteFigurZeit = aktuelleZeit; werIstAmZug = 'S'; aktualisiereAnzeige();
      }
    }
  }

  // ==========================================
  // ZÜGE FÜR SCHWARZ (Nur aktiv, wenn werIstAmZug == 'S')
  // ==========================================
  if (werIstAmZug == 'S') {
    if (digitalRead(tasterSchwarz) == LOW && (aktuelleZeit - letzteUhrSchwarz >= entprellZeitUhr)) {
      digitalWrite(magnetSchwarz, HIGH); magnetAnZeitSchwarz = aktuelleZeit; magnetAktivSchwarz = true;
      letzteUhrSchwarz = aktuelleZeit;
      Keyboard.print("S"); werIstAmZug = 'W'; aktualisiereAnzeige();
    }
    else if (aktuelleZeit - letzteFigurZeit >= entprellZeitFigur) {
      if (digitalRead(pinQ_Schwarz) == LOW) {
        digitalWrite(magnetSchwarz, HIGH); magnetAnZeitSchwarz = aktuelleZeit; magnetAktivSchwarz = true;
        Keyboard.print("q"); letzteFigurZeit = aktuelleZeit; werIstAmZug = 'W'; aktualisiereAnzeige();
      }
      else if (digitalRead(pinR_Schwarz) == LOW) {
        digitalWrite(magnetSchwarz, HIGH); magnetAnZeitSchwarz = aktuelleZeit; magnetAktivSchwarz = true;
        Keyboard.print("r"); letzteFigurZeit = aktuelleZeit; werIstAmZug = 'W'; aktualisiereAnzeige();
      }
      else if (digitalRead(pinB_Schwarz) == LOW) {
        digitalWrite(magnetSchwarz, HIGH); magnetAnZeitSchwarz = aktuelleZeit; magnetAktivSchwarz = true;
        Keyboard.print("b"); letzteFigurZeit = aktuelleZeit; werIstAmZug = 'W'; aktualisiereAnzeige();
      }
      else if (digitalRead(pinN_Schwarz) == LOW) {
        digitalWrite(magnetSchwarz, HIGH); magnetAnZeitSchwarz = aktuelleZeit; magnetAktivSchwarz = true;
        Keyboard.print("n"); letzteFigurZeit = aktuelleZeit; werIstAmZug = 'W'; aktualisiereAnzeige();
      }
    }
  }
}

// ==========================================
// DIE INTELLIGENTE LED-LOGIK
// ==========================================
void aktualisiereAnzeige() {
  // Zuerst alle 4 LEDs komplett ausschalten
  digitalWrite(ledGelbLinks, LOW);
  digitalWrite(ledRotLinks, LOW);
  digitalWrite(ledGelbRechts, LOW);
  digitalWrite(ledRotRechts, LOW);

  if (weissIstLinksSitzen) {
    // Weiß sitzt links (Gelb links) -> Schwarz sitzt rechts (Rot rechts)
    if (werIstAmZug == 'W') {
      digitalWrite(ledGelbLinks, HIGH);
    } else {
      digitalWrite(ledRotRechts, HIGH);
    }
  } 
  else {
    // Weiß sitzt rechts (Gelb rechts) -> Schwarz sitzt links (Rot links)
    if (werIstAmZug == 'W') {
      digitalWrite(ledGelbRechts, HIGH);
    } else {
      digitalWrite(ledRotLinks, HIGH);
    }
  }
}
